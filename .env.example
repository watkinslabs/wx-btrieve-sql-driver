# Copy to `.env` and fill in your dev values. `.env` is gitignored.
#
# Sourced by scripts/btr.sh if present. Never commit real values.

# SSH password for the dev test servers
BTR_DEPLOY_PASS=

# SSH user (the test boxes have a user with a space in the name — quote it)
BTR_DEPLOY_USER="remote dos"

# Dev server hostnames/IPs
# DEV A: runs our wxbtrv stack (wxbtrv.dll → System32)
BTR_DEVA_HOST=
# DEV B: Pervasive reference + btrv-tracer (w3btrv7.dll → System32)
BTR_DEVB_HOST=
